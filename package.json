{
  "name": "bitboard-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "BitBoard monorepo: Electron desktop app and Android app sharing the same P2P torrent engine.",
  "license": "MIT",
  "scripts": {
    "start": "npm run start --prefix electron",
    "dev": "npm run dev --prefix electron",
    "install:electron": "npm install --prefix electron",
    "android": "cd android && .\\gradlew.bat assembleDebug",
    "android:install": "cd android && .\\gradlew.bat installDebug"
  }
}